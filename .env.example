# Local config for an-archive-of-your-own. Copy to .env, which is gitignored
# because AO3_SESSION is a live credential. Loaded by `npm start`; see README.
# .env is read once at process start, so a replaced cookie needs a restart.

# The _otwarchive_session cookie from a logged-in AO3 browser session. Without
# it, works whose authors restricted them to logged-in users cannot be fetched.
# A whole `name=value` paste is accepted, not just the bare value.
AO3_SESSION=

# AO3 asks automated clients to be contactable. Sent in the User-Agent.
ARCHIVE_CONTACT=

# Milliseconds between AO3 requests. Default 5000; do not lower it casually.
AO3_MIN_INTERVAL_MS=

# Interface to bind. Default 127.0.0.1, which is this machine only.
HOST=

# Default 4173.
PORT=
