# Local config for an-archive-of-your-own. Gitignored: AO3_SESSION is a live credential.
# Loaded by npm start; see README. Replace AO3_SESSION when AO3 logs you out.

# The _otwarchive_session cookie from a logged-in AO3 browser session.
AO3_SESSION=

# AO3 asks automated clients to be contactable. Sent in the User-Agent.
ARCHIVE_CONTACT=

AO3_MIN_INTERVAL_MS=

# Default for now
HOST=
PORT=



